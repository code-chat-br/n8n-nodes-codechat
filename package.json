{
	"name": "n8n-nodes-codechat",
	"version": "0.1.0",
	"description": "n8n community nodes for interacting with the CodeChat WhatsApp API",
	"license": "MIT",
	"homepage": "https://docs.codechat.dev",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"codechat",
		"whatsapp",
		"whatsapp-api"
	],
	"author": {
		"name": "Cleber",
		"email": "contato@codechat.dev"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/code-chat-br/n8n-nodes-codechat"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist",
		"!dist/tsconfig.tsbuildinfo"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/CodeChatApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/CodeChat/CodeChat.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "^0.46.4",
		"eslint": "9.39.4",
		"prettier": "3.8.3",
		"release-it": "20.2.0",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
